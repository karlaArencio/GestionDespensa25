@page "/api/Clientes/editar/{clienteId:int}"
@inject IHttpServicio http
@inject NavigationManager navigationManager

<h3>Editar el Cliente</h3>

<EditForm Model="cliente" OnValidSubmit="Grabar">
    <DataAnnotationsValidator />
    <div class="form-group">
        <label>Nombre</label>
        <div>
            <InputText class="form-control" @bind-Value="@cliente.Nombre" />
            <ValidationMessage For="@(() => cliente.Nombre)" />
        </div>
    </div>
    <div class="form-group">
        <label>Apellido</label>
        <div>
            <InputText class="form-control" @bind-Value="@cliente.Apellido" />
            <ValidationMessage For="@(() => cliente.Apellido)" />
        </div>
    </div>
    <div class="form-group">
        <label>DNI</label>
        <div>
            <InputText class="form-control" @bind-Value="@cliente.DNI" />
            <ValidationMessage For="@(() => cliente.DNI)" />
        </div>
    </div>
    <div class="form-group">
        <label>Telefono</label>
        <div>
            <InputText class="form-control" @bind-Value="@cliente.Telefono" />
            <ValidationMessage For="@(() => cliente.Telefono)" />
        </div>
    </div>
    <div class="form-group">
        <label>Direccion</label>
        <div>
            <InputText class="form-control" @bind-Value="@cliente.Direccion" />
            <ValidationMessage For="@(() => cliente.Direccion)" />
        </div>
    </div>
    <div class="form-group">
        <label>Estado</label>
        <div>
            <InputText class="form-control" @bind-Value="@cliente.Estado" />
            <ValidationMessage For="@(() => cliente.Estado)" />
        </div>
    </div>
    <br />
    <button class="btn-primary" type="submit" ">Aceptar</button>
    <button class="btn-secondary" @onclick="Cancelar">Cancelar</button>
</EditForm>

@code {
    [Parameter] public int clienteId { get; set; }
    private Cliente cliente = new Cliente();

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        await Mostrar();
    }
    private async Task Mostrar()
    {
        var respuesta = await http.Get<Cliente>($"api/Clientes/{clienteId:int}");
        if (!respuesta.Error)
        {
            cliente = respuesta.Respuesta;

        }
        else
        {
            navigationManager.NavigateTo("/api/Clientes");
        }
    }
    private async Task Grabar()
    {
        var httpRespuesta = await http.Put<Cliente>("api/Clientes/{clienteId}", cliente);
        if (httpRespuesta.Error)
        {
            var body = httpRespuesta.HttpResponseMessage;
        }
        navigationManager.NavigateTo("/api/Clientes");
    }
    private void Cancelar()
    {
        navigationManager.NavigateTo("/api/Clientes");
    }
}
